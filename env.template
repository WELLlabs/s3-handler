# AWS Configuration
# Option 1: Explicit credentials (leave empty to use IAM role)
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret_key

# Option 2: IAM Role (for EC2 instances)
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty/unset
# The application will automatically use IAM role credentials from EC2 instance metadata

# JWT Secret for access token generation
SECRET=your_jwt_secret_key
JWT_EXPIRATION_MINUTES=10

# Application configuration
APP_NAME="AWS S3 Handler API"
PORT=8000
HOST=0.0.0.0
RELOAD=False

# Multipart upload configuration
MULTIPART_CHUNK_SIZE_MB=50
MAX_PART_NUMBER=10000
PRESIGNED_URL_EXPIRATION_MINUTES=60

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2.0

# Timeout configuration
UPLOAD_TIMEOUT_SECONDS=300
DOWNLOAD_TIMEOUT_SECONDS=300
